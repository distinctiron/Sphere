DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=""  # generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional - for federated authentication)
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# For Anthropic (default model: claude-sonnet-5-5)
LLM_PROVIDER="anthropic"
LLM_API_KEY=""  # sk-ant-...
LLM_MODEL="claude-sonnet-5-5"  # Optional

# For OpenAI
#LLM_PROVIDER="openai"
#LLM_API_KEY=""
#LLM_MODEL="gpt-5.1"  # Optional

# For Mock (default - no API key needed)
#LLM_PROVIDER="mock"

# arxiv user email to fetch articles
#SEED_USER_EMAIL="sferrum@distinct.dk"

# Stripe payments (Epic 5): use test-mode keys locally
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Locally: the secret printed by `stripe listen --print-secret`; in production: the endpoint's signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: use an existing €10/month Price; otherwise one is created on first checkout (lookup key sphere_unlimited_monthly_eur_1000)
#STRIPE_SUBSCRIPTION_PRICE_ID="price_..."

# Billing and metering
#USD_TO_EUR="0.86"                  # Converts provider USD token prices to euros
#SUBSCRIPTION_FAIR_USE_EUR="6"      # Real inference cost per subscriber per billing period before the wallet is used
#BILLING_PRICE_MOCK_AS="claude-sonnet-5-5"    # Dev only: charge mock-mode AI calls as if they ran on this model

# Scheduled paper processing (Epic 6)
# Run the hourly fetch → score → index pipeline inside the Next.js server
ENABLE_SCHEDULER="false"
#JOB_INTERVAL_MINUTES="60"          # How often the pipeline runs
#JOB_SCHEDULE_OFFSET_MINUTES="5"    # Minute past the interval (hh:05)
#JOB_RUN_ON_STARTUP="false"
#DISABLED_JOBS=""                   # e.g. "rag-indexing"
# Protects /api/cron/* (external schedulers send "Authorization: Bearer <secret>")
#CRON_SECRET=""
#ARXIV_FETCH_CATEGORIES="cs.*,physics.*"
#ARXIV_FETCH_LOOKBACK_HOURS="96"
#ARXIV_FETCH_MAX_PAGES="30"         # 200 papers per page
#NOVELTY_SCORING_MAX_PER_RUN="100"
#NOVELTY_SCORING_CONCURRENCY="5"

# Retrieval-augmented chat & explanations (Epic 7)
# Embeddings use OpenAI when OPENAI_API_KEY is set (or LLM_PROVIDER=openai with LLM_API_KEY),
# otherwise local lexical embeddings (no API needed, lower quality)
#OPENAI_API_KEY=""
#EMBEDDING_PROVIDER=""              # "openai" | "local"
#EMBEDDING_MODEL="text-embedding-3-small"
#RAG_MIN_SIMILARITY=""              # default 0.25 (openai) / 0.08 (local)
#RAG_CHAT_TOP_K="4"
#RAG_PREINDEX_NEW_PAPERS="true"     # Index new papers in the scheduled job, not just opened ones
#RAG_INDEX_MAX_PER_RUN="25"

# Breaking AI news (Epic 8)
# The "process-news" pipeline (fetch → cluster → summarize) runs with the scheduler above
#NEWS_INTERVAL_MINUTES="15"
#NEWS_SCHEDULE_OFFSET_MINUTES="2"
#NEWS_FETCH_WINDOW_HOURS="48"
#DISABLED_NEWS_SOURCES=""           # e.g. "reddit,x" (hackernews, reddit, github, rss, x)
#DISABLED_NEWS_FEEDS=""             # feed names, e.g. "Google News" (personal, non-commercial use only)
#NEWS_CLUSTER_THRESHOLD=""          # default 0.62 (openai embeddings) / 0.4 (local)
#NEWS_HEAT_HALF_LIFE_HOURS="8"
#NEWS_SUMMARIZE_MAX_PER_RUN="15"
#NEWS_ARTICLE_PREGEN_MAX_PER_RUN="3" # Articles written ahead of time for breaking stories
# Reddit: without credentials public feeds are used (no upvote counts, ~1 request/minute).
# Create a free "script" app at https://www.reddit.com/prefs/apps for scores:
#REDDIT_CLIENT_ID=""
#REDDIT_CLIENT_SECRET=""
#REDDIT_USER_AGENT="Sphere/0.1 by your-reddit-username"
#GITHUB_TOKEN=""                    # Optional; raises GitHub API rate limits
# X via an RSS bridge (off unless set). Self-hosted RSSHub or a Nitter instance; {user} is replaced:
#X_RSS_URL_TEMPLATE="http://localhost:1200/twitter/user/{user}"
#X_ACCOUNTS=""                      # Comma-separated handles; defaults to major AI labs and researchers
